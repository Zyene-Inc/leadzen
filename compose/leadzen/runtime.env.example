# Backend only. Replace placeholders through a private secret store.
LEADZEN_ENV=production
LEADZEN_DB=/opt/leadzen/data/db.sqlite3
LEADZEN_WORKSPACE_ROOT=/opt/leadzen/data/workspaces
LEADZEN_SETTINGS_KEY=REPLACE_WITH_FERNET_KEY_KEEP_STABLE
LEADZEN_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SIGNING_SECRET_KEEP_STABLE
LEADZEN_DASHBOARD_TOKEN=REPLACE_WITH_RANDOM_SERVER_TO_SERVER_SECRET
LEADZEN_PUBLIC_URL=https://leadzen.zyene.com
LEADZEN_DASHBOARD_ORIGINS=https://leadzen.zyene.com
# Optional remote assistant endpoint. Leave empty until an authorized HTTPS rollout.
# OAuth metadata and /mcp must reach this same API host; never a dashboard API proxy.
LEADZEN_MCP_PUBLIC_URL=
LEADZEN_ALLOWED_HOSTS=leadzen-api.zyene.com,localhost,127.0.0.1
LEADZEN_RESEND_API_KEY=REPLACE_WITH_PRIVATE_RESEND_KEY
LEADZEN_INVITATION_FROM="LeadZen by Zyene <accounts@leadzen.zyene.com>"
# Comma-separated exact trusted hosts only; no wildcards or private addresses.
LEADZEN_LLM_HOSTS=
LEADZEN_MAIL_HOSTS=
LEADZEN_EMAIL_HOSTS=
# Opt in only when the reviewed follow-up service is intentionally enabled.
LEADZEN_AUTOMATIC_FOLLOWUPS_ENABLED=0

# Separately authorized standing outreach. Disabled until an approved rollout.
LEADZEN_AUTOPILOT_ENABLED=0
