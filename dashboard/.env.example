LEADZEN_API_URL=http://127.0.0.1:8000
LEADZEN_API_TOKEN=replace-with-a-long-random-token
# Production LEADZEN_API_URL must use HTTPS.
# Required in production (Vercel and standalone TLS reverse proxies):
# LEADZEN_DASHBOARD_PUBLIC_URL=https://leadzen.example.com
# This must be an exact origin, with no path, query or embedded credentials.
# Individual accounts and revocable sessions are managed by the Django API.
